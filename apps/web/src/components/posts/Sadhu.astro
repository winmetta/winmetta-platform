---
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/messages';
import { postFeedbackEnabled } from '../../lib/feedback';
interface Props {
  locale: Locale;
  post: string;
}
const { locale, post } = Astro.props;
---

{postFeedbackEnabled && (
  <div class="sadhu-card js-only no-print">
    <button
      type="button"
      class="sadhu"
      aria-label={t(locale, 'sadhu')}
      title={t(locale, 'sadhu')}
      aria-describedby="sadhu-hint"
      data-sadhu={post}
      data-thanks={t(locale, 'sadhuThanks')}
    >
      <span aria-hidden="true">🙏</span>
    </button>
    <div>
      <p class="font-semibold">{t(locale, 'sadhu')}</p>
      <p id="sadhu-hint" class="sadhu-hint">
        {t(locale, 'sadhuHint')}
      </p>
      <p
        role="status"
        aria-live="polite"
        class="mt-1 font-semibold text-brand"
        data-sadhu-status
      ></p>
    </div>
  </div>
)}
<script>
  import { track } from '../../lib/analytics';
  const button = document.querySelector<HTMLButtonElement>('[data-sadhu]');
  button?.addEventListener('click', () => {
    if (button.disabled) return;
    button.disabled = true;
    track('post_reaction', { post: button.dataset.sadhu ?? '', kind: 'sadhu' });
    const status = document.querySelector('[data-sadhu-status]');
    if (status) status.textContent = button.dataset.thanks ?? '';
  });
</script>
