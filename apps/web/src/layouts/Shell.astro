---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { locales, localeCodes, type Locale } from '../i18n/locales';
import { route, type PageId } from '../i18n/routes';
import { t } from '../i18n/messages';
import { allowIndexing } from '../lib/site';
interface Props {
  locale: Locale;
  title: string;
  page?: PageId;
  /** Path after the locale for pages that are not in pagePaths, e.g. dhamma-library/folders/f001/. */
  path?: string;
}
const { locale, title, page = 'home', path } = Astro.props;
const href = (code: Locale) => (path ? `/${code}/${path}` : route(code, page));
const canonical = new URL(href(locale), Astro.site);
const inLibrary =
  page === 'library' || Boolean(path?.startsWith('dhamma-library/'));
---

<!doctype html>
<html lang={locale} dir={locales[locale].direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!allowIndexing && <meta name="robots" content="noindex" />}
    <title>{title} · {t(locale, 'brand')}</title>
    <link rel="canonical" href={canonical} />
    {
      localeCodes.map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(href(code), Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{t(locale, 'skip')}</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a href={route(locale)} class="brand">
          <img src="/logo-96.png" width="44" height="44" alt="" />
          <span>{t(locale, 'brand')}</span>
        </a>
        <nav aria-label={t(locale, 'navMain')}>
          <a
            href={route(locale, 'library')}
            class="nav-link"
            aria-current={page === 'library'
              ? 'page'
              : inLibrary
                ? 'true'
                : undefined}>{t(locale, 'navLibrary')}</a
          >
        </nav>
        <LanguageSwitcher locale={locale} />
      </div>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav
          aria-label={t(locale, 'footerNav')}
          class="-ms-3 flex flex-wrap items-center gap-x-1"
        >
          <a
            href={route(locale, 'about')}
            class="footer-link"
            aria-current={page === 'about' ? 'page' : undefined}
            >{t(locale, 'navAbout')}</a
          >
          <a
            href={route(locale, 'privacy')}
            class="footer-link"
            aria-current={page === 'privacy' ? 'page' : undefined}
            >{t(locale, 'navPrivacy')}</a
          >
          <a href="https://winmetta.org/" class="footer-link" rel="noopener"
            >winmetta.org</a
          >
        </nav>
        <p class="muted">{t(locale, 'footerNote')}</p>
      </div>
    </footer>
  </body>
</html>
