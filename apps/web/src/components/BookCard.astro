---
import type { LibraryFile } from '../lib/schemas';
import { fileUrl } from '../lib/library-index';
import { formatSize } from '../lib/library-url';
import { t } from '../i18n/messages';
import { locales, type Locale } from '../i18n/locales';
import { libraryCdnBase } from '../lib/site';
interface Props {
  record: LibraryFile;
  locale: Locale;
}
const { record, locale } = Astro.props;
---

<li class="card flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
  <h3
    class="min-w-0 grow basis-64 text-lg font-semibold"
    lang={record.language}
  >
    {record.title}
    {
      record.titleNote && (
        <span class="muted font-normal"> ({record.titleNote})</span>
      )
    }
  </h3>
  <p class="flex items-center gap-3 text-sm">
    <span class="badge"
      >{formatSize(record.sizeBytes, locales[locale].formatLocale)}</span
    >
    <a
      class="btn btn-outline"
      href={fileUrl(libraryCdnBase, record.key)}
      aria-label={`${t(locale, 'download')}: ${record.title}`}
      rel="noopener">{t(locale, 'download')}</a
    >
  </p>
</li>
