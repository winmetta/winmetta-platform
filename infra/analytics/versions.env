# Pinned versions for the analytics server. Change them here (and review the release notes),
# then re-run install.sh on the instance. Checked 2026-10-30; do not copy versions from memory.
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4.1
POSTGRES_IMAGE=postgres:18-alpine
CADDY_VERSION=2.11.7
# github.com/mholt/caddy-ratelimit, pinned to a commit (the module has no stable release).
CADDY_RATELIMIT_REF=5625512f24f6f59d6f64fb3aafe5eecff0b286db

# Tools for working on the box (bin/setup-shell.sh). ShellCheck, shfmt and the ALE vim plugin
# are not in the Amazon Linux repositories, so they are downloaded and checked against these
# SHA-256 sums. Checked 2026-10-30 (GitHub releases); update version and sums together.
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_AARCH64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
SHELLCHECK_SHA256_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHFMT_VERSION=3.14.1
SHFMT_SHA256_ARM64=5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489
SHFMT_SHA256_AMD64=76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf
ALE_VERSION=4.0.0
ALE_SHA256=fc6fd9640eb03b0fa1e2ebd40455b87e39119e99b78212d8f3b1441de3a7a8bc
# The psql client from the Amazon Linux repository; keep the major in step with POSTGRES_IMAGE.
POSTGRES_CLIENT_PACKAGE=postgresql18

