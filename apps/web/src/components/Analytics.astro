---
import {
  analyticsEnabled,
  analyticsHost,
  analyticsWebsiteId,
} from '../lib/analytics-config';
interface Props {
  /** The 404 page reports one constant path and a `page_not_found` section label. */
  notFound?: boolean;
}
const { notFound = false } = Astro.props;
const domain = new URL(Astro.site ?? 'http://localhost').hostname;
---

{
  /* Off unless the build sets PUBLIC_ANALYTICS=true: then this element is absent and
  analytics-client.ts does nothing. */
}
{
  analyticsEnabled && (
    <script
      is:inline
      type="application/json"
      id="analytics-config"
      data-host={analyticsHost}
      data-website-id={analyticsWebsiteId}
      data-domain={domain}
      data-not-found={String(notFound)}
    />
  )
}
<script>
  import '../lib/analytics-client';
</script>
