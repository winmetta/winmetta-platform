---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/messages';
import { feedbackOptions } from '../lib/feedback';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<dialog
  class="feedback-dialog no-print"
  aria-labelledby="feedback-heading"
  aria-describedby="feedback-note"
  data-feedback-dialog
  data-locale={locale}
  data-options={JSON.stringify(feedbackOptions(locale))}
  data-sending={t(locale, 'feedbackSending')}
  data-success={t(locale, 'feedbackThanks')}
  data-error={t(locale, 'feedbackError')}
>
  <div class="space-y-4">
    <div class="flex items-start justify-between gap-4">
      <h2 id="feedback-heading" class="text-2xl font-bold">
        {t(locale, 'feedbackLink')}
      </h2>
      <button
        type="button"
        class="btn btn-outline shrink-0 px-3"
        aria-label={t(locale, 'feedbackClose')}
        data-feedback-close
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>
    </div>
    <p id="feedback-note" class="muted text-sm">
      {t(locale, 'feedbackNote')}
    </p>
    <p class="text-sm break-words">
      {t(locale, 'feedbackAbout')}: <span data-feedback-about></span>
    </p>
    <form class="space-y-4" data-feedback-form>
      <label class="block space-y-1">
        <span class="block font-semibold">{t(locale, 'feedbackType')}</span>
        <select class="field" name="type" required></select>
      </label>
      <label class="block space-y-1">
        <span class="block font-semibold">{t(locale, 'feedbackMessage')}</span>
        <textarea
          class="field"
          name="message"
          rows="5"
          required
          maxlength="2000"
        ></textarea>
      </label>
      <label class="block space-y-1">
        <span class="block font-semibold">{t(locale, 'feedbackEmail')}</span>
        <input
          class="field"
          name="email"
          type="email"
          maxlength="254"
          autocomplete="email"
        />
      </label>
      <div class="feedback-honeypot" aria-hidden="true" inert>
        <label>
          Website
          <input name="hp" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <button class="btn btn-primary" type="submit">
        {t(locale, 'feedbackSend')}
      </button>
    </form>
    <p role="status" aria-live="polite" tabindex="-1" data-feedback-status></p>
    <p class="text-sm">
      <a class="link" data-feedback-fallback href="mailto:contact@winmetta.org">
        {t(locale, 'feedbackEmailInstead')}
      </a>
    </p>
  </div>
</dialog>
<script>
  import { initFeedback } from '../lib/feedback-client';
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-feedback-dialog]',
  );
  if (dialog) initFeedback(dialog);
</script>
