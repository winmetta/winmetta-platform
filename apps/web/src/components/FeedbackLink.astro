---
import {
  feedbackEnabled,
  postFeedbackEnabled,
  feedbackMailto,
} from '../lib/feedback';
import type { FeedbackContext } from '../lib/feedback-schema';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/messages';
interface Props {
  locale: Locale;
  ctx?: FeedbackContext;
  item?: string;
  lang?: string;
  class?: string;
}
const {
  locale,
  ctx = 'general',
  item = '',
  lang = '',
  class: css = 'link text-sm',
} = Astro.props;
const enabled = ctx === 'post' ? postFeedbackEnabled : feedbackEnabled;
// "Something wrong?" links carry a small flag icon; the footer's general link is text only.
const withIcon = ctx !== 'general';
const page = Astro.url.pathname;
---

{enabled && (
  <a
    class={`no-print ${css}${withIcon ? ' icon-link' : ''}`}
    href={feedbackMailto(page, item, lang)}
    data-feedback={ctx}
    data-feedback-page={page}
    data-feedback-item={item}
    data-feedback-lang={lang}
  >
    {withIcon && (
      <svg
        class="size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
        <path d="M4 22v-7" />
      </svg>
    )}
    {t(locale, ctx === 'general' ? 'feedbackLink' : 'feedbackProblem')}
  </a>
)}
