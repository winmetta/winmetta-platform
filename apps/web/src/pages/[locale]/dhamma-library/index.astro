---
import Shell from '../../../layouts/Shell.astro';
import LibrarySearchIsland from '../../../components/LibrarySearchIsland';
import BookSearchIsland from '../../../components/BookSearchIsland';
import { bookSearchEnabled } from '../../../lib/book-search';
import { locales, localeCodes, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/messages';
import { route } from '../../../i18n/routes';
import { libraryData } from '../../../lib/library-data';
import { libraryCdnBase } from '../../../lib/site';
import FolderTree from '../../../components/FolderTree.astro';
import { tree } from '../../../lib/library-catalog';
export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (key: Parameters<typeof t>[1]) => t(locale, key);
const labels = {
  locale,
  searchLabel: text('searchLabel'),
  searchPlaceholder: text('searchPlaceholder'),
  searchLoading: text('searchLoading'),
  searchError: text('searchError'),
  searchRetry: text('searchRetry'),
  results: text('results'),
  similarBooks: text('similarBooks'),
  noExact: text('noExact'),
  noResults: text('noResults'),
  tryFolders: text('tryFolders'),
  resetSearch: text('resetSearch'),
  folder: text('folder'),
  removeFolder: text('removeFolder'),
  download: text('download'),
  viewApp: text('studyAppsView'),
  pagesOne: text('bookPagesOne'),
  pagesOther: text('bookPagesOther'),
  showMore: text('showMore'),
};
const bookSearchLabels = {
  title: text('bookSearchTitle'),
  intro: text('bookSearchIntro'),
  label: text('bookSearchLabel'),
  placeholder: text('bookSearchPlaceholder'),
  button: text('bookSearchButton'),
  searching: text('bookSearchSearching'),
  noResults: text('bookSearchNoResults'),
  tooShort: text('bookSearchTooShort'),
  unavailable: text('bookSearchUnavailable'),
  retry: text('searchRetry'),
  page: text('bookSearchPage'),
  ocr: text('bookSearchOcr'),
  printedNote: text('bookSearchPrintedNote'),
  open: text('bookSearchOpen'),
  copy: text('bookSearchCopy'),
  copied: text('bookSearchCopied'),
  more: text('bookSearchMore'),
  results: text('bookSearchResults'),
};
---

<Shell locale={locale} title={text('libraryTitle')} page="library">
  <header class="space-y-4">
    <h1 class="text-3xl font-bold sm:text-4xl">{text('libraryTitle')}</h1>
    <p class="lead">{text('libraryIntro')}</p>
    <p class="flex flex-col gap-2">
      <a class="link" href={`/${locale}/dhamma-library/apps/`}>
        {text('studyAppsLink')} →
      </a>
      <a class="link" href={`/${locale}/dhamma-library/digital-texts/`}>
        {text('digitalTextsLink')} →
      </a>
      <a class="link" href={route(locale, 'posts')}>
        {text('libraryPostsLink')} →
      </a>
    </p>
  </header>
  <noscript>
    <p class="card">{text('searchNeedsJs')}</p>
  </noscript>
  <div>
    <LibrarySearchIsland
      client:load
      labels={labels}
      indexUrl={`/library-data/index.${libraryData.version}.json`}
      recordsUrl={`/library-data/records.${libraryData.version}.json`}
      cdnBase={libraryCdnBase}
      formatLocale={locales[locale].formatLocale}
    />
  </div>
  {/* An island renders as `display: contents`, so the page's vertical spacing (space-y on the
      main column, a bottom margin on each child) only reaches it through a real wrapper element,
      one around each island (docs/design-guide.md). */}
  {bookSearchEnabled && (
    <div>
      <BookSearchIsland
        client:load
        labels={bookSearchLabels}
        formatLocale={locales[locale].formatLocale}
      />
    </div>
  )}
  <section class="space-y-3" aria-labelledby="folders">
    <h2 id="folders" class="text-2xl font-bold">
      {text('browseFolders')}
    </h2>
    <div class="card">
      <FolderTree tree={tree} nodes={tree.roots} locale={locale} nested />
    </div>
  </section>
</Shell>
