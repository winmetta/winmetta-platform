---
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/messages';
import { postFeedbackEnabled } from '../../lib/feedback';
interface Props {
  locale: Locale;
  post: string;
}
const { locale, post } = Astro.props;
---

{postFeedbackEnabled && (
  <div class="js-only no-print space-y-2">
    <button
      type="button"
      class="sadhu"
      data-sadhu={post}
      data-thanks={t(locale, 'sadhuThanks')}
    >
      <svg
        class="size-6 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 3c2.6 2.4 3.4 5.6 0 10-3.4-4.4-2.6-7.6 0-10z" />
        <path d="M12 13C8.3 13 5.2 11 4 7.5 7.6 7 10.7 8.8 12 13z" />
        <path d="M12 13c3.7 0 6.8-2 8-5.5-3.6-.5-6.7 1.3-8 5.5z" />
        <path d="M4 17c2.8 1.8 5.2 2.5 8 2.5s5.2-.7 8-2.5" />
      </svg>
      {t(locale, 'sadhu')}
    </button>
    <p role="status" aria-live="polite" data-sadhu-status></p>
  </div>
)}
<script>
  import { track } from '../../lib/analytics';
  const button = document.querySelector<HTMLButtonElement>('[data-sadhu]');
  button?.addEventListener('click', () => {
    if (button.disabled) return;
    button.disabled = true;
    track('post_reaction', { post: button.dataset.sadhu ?? '', kind: 'sadhu' });
    const status = document.querySelector('[data-sadhu-status]');
    if (status) status.textContent = button.dataset.thanks ?? '';
  });
</script>
