---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import SmokeIsland from '../../components/SmokeIsland';
import { localeCodes, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/messages';
import { localizedContent } from '../../i18n/content';
export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const pages = await getCollection('pages');
const fixture = pages.find((page) => page.data.sourceLanguage === locale);
if (!fixture) throw new Error(`Missing smoke fixture: ${locale}`);
const content = localizedContent(
  fixture.data.translations,
  fixture.data.sourceLanguage,
  locale,
);
---

<Shell locale={locale} title={content.value.title}>
  <h1 class="text-2xl font-bold sm:text-3xl" lang={content.language}>
    {content.value.title}
  </h1>
  <p class="max-w-prose" lang={content.language}>{content.value.description}</p>
  {
    content.isFallback && (
      <p>
        {t(locale, 'fallback')}: {content.language}
      </p>
    )
  }
  <SmokeIsland
    client:load
    show={t(locale, 'showDetails')}
    hide={t(locale, 'hideDetails')}
    details={t(locale, 'details')}
  />
</Shell>
