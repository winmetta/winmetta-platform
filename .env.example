# Committed documentation. Copy to root .env.local for developer-machine overrides.
# CI uses GitHub production environment variables; do not create env files for them.
# Never put secrets in PUBLIC_* variables: they can appear in the generated site.
# Origin used for canonical and alternate-language URLs. Defaults to http://localhost:4321.
SITE_URL=http://localhost:4321
# Only the public production site sets this to "true". Anything else sends noindex.
PUBLIC_ALLOW_INDEXING=false
# Public origin that serves library PDFs. Defaults to the existing bunny.net pull zone.
PUBLIC_LIBRARY_CDN_BASE=https://dhamma-library.b-cdn.net
# Cookieless Umami analytics (docs/analytics.md). Off unless PUBLIC_ANALYTICS is "true" AND a website id is set;
# only the public production build turns it on (Phase 4 stage 4). The website id is public, not a secret.
PUBLIC_ANALYTICS=false
PUBLIC_ANALYTICS_WEBSITE_ID=
PUBLIC_ANALYTICS_HOST=https://stats.app.winmetta.org
# Feedback dialog and context links (docs/feedback.md). Off until the endpoint is ready.
PUBLIC_FEEDBACK=false
# Keep post reports and Sādhu off until the native-reader/teacher wording review is complete.
PUBLIC_FEEDBACK_POSTS_REVIEWED=false
