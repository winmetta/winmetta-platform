---
// Layout for a mini app page (docs/meditation-bell.md §2): the whole screen for the app, with no
// site header, navigation, logo or footer. Keeps what every page needs (styles, lang, title,
// canonical and hreflang, analytics). Top bar: a real link back to the listing and the language
// switch. Footer: only the Feedback button.
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import FeedbackDialog from '../components/FeedbackDialog.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { feedbackEnabled, feedbackMailto } from '../lib/feedback';
import { miniAppsEnabled } from '../lib/mini-apps';
import { locales, localeCodes, type Locale } from '../i18n/locales';
import { route } from '../i18n/routes';
import { t } from '../i18n/messages';
import { allowIndexing, isBeta } from '../lib/site';
interface Props {
  locale: Locale;
  /** The mini app's name; also the "item" of a feedback report. */
  title: string;
  /** Path after the locale, e.g. mini-apps/meditation-bell/. */
  path: string;
  /** Keeps the page out of search results even when mini apps are on (an app not yet approved). */
  noindex?: boolean;
}
const { locale, title, path, noindex = false } = Astro.props;
const href = (code: Locale) => `/${code}/${path}`;
const canonical = new URL(href(locale), Astro.site);
const page = Astro.url.pathname;
const customHeader = Astro.slots.has('app-header');
---

<!doctype html>
<html lang={locale} dir={locales[locale].direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(!allowIndexing || !miniAppsEnabled || noindex) && (
      <meta name="robots" content="noindex" />
    )}
    <title>{title} · {t(locale, 'brand')}</title>
    <link rel="canonical" href={canonical} />
    {localeCodes.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(href(code), Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Analytics />
  </head>
  <body
    class:list={[
      'flex min-h-screen flex-col',
      { 'mini-app--custom': customHeader },
    ]}
    data-mini-app
    data-leave-message={t(locale, 'miniAppLeaveConfirm')}
  >
    <a href="#main" class="skip-link">
      {t(locale, 'skip')}
    </a>
    {customHeader ? (
      <slot name="app-header" />
    ) : (
      <header class="mini-bar" data-mini-bar>
        <div class="mini-bar__inner">
          <a
            href={route(locale, 'miniApps')}
            class="footer-link"
            aria-label={t(locale, 'miniAppBackLabel')}
          >
            <span aria-hidden="true" class="me-1 rtl:rotate-180">
              ←
            </span>
            {t(locale, 'miniAppBack')}
          </a>
          {isBeta && (
            <span class="badge" aria-hidden="true">
              {t(locale, 'betaLabel')}
            </span>
          )}
          <LanguageSwitcher locale={locale} compact />
        </div>
      </header>
    )}
    <main
      id="main"
      class={
        customHeader
          ? 'mini-app-content'
          : 'mx-auto w-full max-w-3xl flex-1 space-y-6 px-4 pt-6'
      }
    >
      <slot />
    </main>
    <footer class="mini-footer">
      {feedbackEnabled && (
        <a
          class={
            customHeader
              ? 'mini-app-feedback no-print'
              : 'btn btn-outline no-print'
          }
          href={feedbackMailto(page, title)}
          data-feedback="general"
          data-feedback-page={page}
          data-feedback-item={title}
          aria-label={t(locale, 'feedbackLink')}
        >
          <svg
            class="size-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="max-sm:sr-only">{t(locale, 'miniAppFeedback')}</span>
        </a>
      )}
    </footer>
    {feedbackEnabled && <FeedbackDialog locale={locale} />}
    <script>
      // A mini app that holds running state (a timer, an active schedule) sets
      // document.body.dataset.miniAppBusy = 'true'. Leaving through the top bar then asks first
      // (the message is in data-leave-message), and closing the tab shows the browser's own warning.
      const message = document.body.dataset.leaveMessage ?? '';
      const busy = () => document.body.dataset.miniAppBusy === 'true';
      document.addEventListener(
        'click',
        (event) => {
          if (!busy() || !(event.target instanceof Element)) return;
          const link = event.target.closest('a');
          if (!link?.closest('[data-mini-bar]')) return;
          if (!window.confirm(message)) {
            event.preventDefault();
            event.stopPropagation();
          }
        },
        true,
      );
      window.addEventListener('beforeunload', (event) => {
        if (busy()) event.preventDefault();
      });
    </script>
  </body>
</html>
