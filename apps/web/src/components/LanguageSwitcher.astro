---
import { locales, localeCodes, type Locale } from '../i18n/locales';
import { switchLocale } from '../i18n/routes';
import { t } from '../i18n/messages';
interface Props {
  locale: Locale;
  /** Mini apps: "EN | ကခဂ" with the language's English name as the accessible name. */
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const short = { en: 'EN', my: 'ကခဂ' } as const;
const longName = {
  en: 'miniAppLanguageEnglish',
  my: 'miniAppLanguageMyanmar',
} as const;
---

<nav aria-label={t(locale, 'language')} class="segmented">
  {localeCodes.map((code) => (
    <a
      href={switchLocale(Astro.url, code)}
      lang={code}
      hreflang={code}
      aria-current={code === locale ? 'page' : undefined}
      data-locale={code}
      aria-label={compact ? t(locale, longName[code]) : undefined}
      class={compact ? 'lang-compact' : undefined}
    >
      {compact ? short[code] : locales[code].name}
    </a>
  ))}
</nav>
<script>
  import '../i18n/language-switch-links';
</script>
