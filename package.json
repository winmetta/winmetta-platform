{
  "name": "winmetta-platform",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "npm run dev:stop --workspace @winmetta/web",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "npm run test:smoke --workspace @winmetta/web",
    "library:manifest": "node scripts/generate-library-manifest.mjs",
    "library:pages": "node scripts/add-library-pages.mjs",
    "book-search:setup": "node apps/book-search/src/cli.ts setup",
    "book-search:fetch": "node apps/book-search/src/cli.ts fetch",
    "book-search:index": "node apps/book-search/src/cli.ts index",
    "book-search:backfill": "node apps/book-search/src/backfill.ts",
    "book-search:build": "node apps/book-search/src/cli.ts build",
    "book-search:publish": "node apps/book-search/src/publish.ts",
    "book-search:golden": "node apps/book-search/src/golden.ts",
    "book-search:serve": "node apps/book-search/src/search-cli.ts serve",
    "book-search": "node apps/book-search/src/search-cli.ts",
    "posts:new": "node scripts/new-post.mjs",
    "posts:validate": "node scripts/validate-posts.mjs",
    "feedback:build": "npm run build --prefix infra/feedback",
    "feedback:test": "npm test --prefix infra/feedback",
    "feedback:typecheck": "npm run typecheck --prefix infra/feedback",
    "book-search-lambda:build": "npm run build --prefix infra/book-search",
    "book-search-lambda:test": "npm test --prefix infra/book-search",
    "book-search-lambda:typecheck": "npm run typecheck --prefix infra/book-search"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "myanmar-tools": "1.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
