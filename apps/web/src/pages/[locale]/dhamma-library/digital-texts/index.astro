---
import Shell from '../../../../layouts/Shell.astro';
import { localeCodes, type Locale } from '../../../../i18n/locales';
import { t } from '../../../../i18n/messages';
import LinkIcon from '../../../../components/LinkIcon.astro';
import githubIcon from '../../../../assets/brand/github.svg?url';

export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (key: Parameters<typeof t>[1]) => t(locale, key);

// Sources: each project's repository and README; links and terms checked 2026-11-23.
const projects = [
  {
    id: 'vri-tipitaka-xml',
    title: 'VRI Chaṭṭha Saṅgāyana Tipiṭaka XML',
    description: text('digitalTextsVri'),
    terms: text('digitalTextsVriTerms'),
    links: [
      {
        label: text('digitalTextsBurmese'),
        icon: 'file',
        url: 'https://github.com/VipassanaTech/tipitaka-xml/tree/main/mymr',
      },
      {
        label: text('studyAppsVisit'),
        icon: 'language',
        url: 'https://www.tipitaka.org/',
      },
    ],
  },
  {
    id: 'tipitaka-markdown',
    title: 'Tipiṭaka Editions in Markdown',
    description: text('digitalTextsMarkdown'),
    terms: text('digitalTextsMarkdownTerms'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/tipitaka-md/cst',
      },
      {
        label: text('studyAppsVisit'),
        icon: 'language',
        url: 'https://tipitaka-md.github.io/',
      },
    ],
  },
  {
    id: 'cst-reader',
    title: 'CST Reader 5',
    description: text('digitalTextsCst'),
    terms: text('digitalTextsNoLicense'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/fsnow/cst',
      },
    ],
  },
  {
    id: 'tipitaka-pali-reader-source',
    title: 'Tipitaka Pāḷi Reader',
    description: text('digitalTextsReader'),
    terms: text('digitalTextsNoLicense'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/bksubhuti/tipitaka-pali-reader',
      },
      {
        label: text('digitalTextsReleases'),
        icon: 'file',
        url: 'https://github.com/bksubhuti/tipitaka-pali-reader/releases',
      },
    ],
  },
  {
    id: 'pn-daza-source',
    title: 'Pn Daza',
    description: text('digitalTextsPnDaza'),
    terms: text('digitalTextsPnDazaTerms'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/pndaza',
      },
    ],
  },
  {
    id: 'digital-nissaya',
    title: 'Digital Nissaya Project',
    description: text('digitalTextsNissaya'),
    terms: text('digitalTextsNoLicense'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/iapt-platform/digital-nissaya',
      },
    ],
  },
  {
    id: 'myanmar-burmese-legacy-fonts',
    title: 'Myanmar Burmese Legacy Fonts',
    description: text('digitalTextsFonts'),
    terms: text('digitalTextsFontsTerms'),
    links: [
      {
        label: text('digitalTextsSource'),
        icon: 'github',
        url: 'https://github.com/winmetta/myanmar-burmese-legacy-fonts',
      },
      {
        label: text('digitalTextsFontsCatalogue'),
        icon: 'file',
        url: 'https://github.com/winmetta/myanmar-burmese-legacy-fonts/blob/main/FONTS.md',
      },
    ],
  },
] as const;
---

<Shell locale={locale} title={text('digitalTextsTitle')} page="digitalTexts">
  <header class="space-y-4">
    <a class="link inline-block" href={`/${locale}/dhamma-library/`}>
      ← {text('studyAppsBack')}
    </a>
    <h1 class="text-3xl font-bold sm:text-4xl">{text('digitalTextsTitle')}</h1>
    <p class="lead">{text('digitalTextsIntro')}</p>
    <p class="muted text-sm">{text('digitalTextsChecked')}</p>
  </header>
  <ul class="grid gap-4 md:grid-cols-2">
    {projects.map((project) => (
      <li id={project.id} class="card space-y-4">
        <h2 class="text-xl font-bold">{project.title}</h2>
        <p>{project.description}</p>
        <p class="muted text-sm">
          <strong>{text('digitalTextsTerms')}:</strong> {project.terms}
        </p>
        <ul class="flex flex-wrap gap-2">
          {project.links.map((link) => (
            <li>
              <a
                class="btn btn-outline px-3 py-2 text-sm"
                href={link.url}
                aria-label={`${link.label}: ${project.title}`}
              >
                {link.icon === 'github' ? (
                  <img src={githubIcon} class="size-4" alt="" loading="lazy" />
                ) : (
                  <LinkIcon name={link.icon} />
                )}
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Shell>
