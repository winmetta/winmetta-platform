{
  "name": "winmetta-platform",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "npm run dev:stop --workspace @winmetta/web",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "npm run test:smoke --workspace @winmetta/web",
    "library:manifest": "node scripts/generate-library-manifest.mjs",
    "posts:new": "node scripts/new-post.mjs",
    "posts:validate": "node scripts/validate-posts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "myanmar-tools": "1.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
