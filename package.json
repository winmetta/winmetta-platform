{
  "name": "winmetta-platform",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "npm run test:smoke --workspace @winmetta/web",
    "library:manifest": "node scripts/generate-library-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.11.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.56.0"
  }
}
