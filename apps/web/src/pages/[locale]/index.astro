---
import Shell from '../../layouts/Shell.astro';
import { localeCodes, type Locale } from '../../i18n/locales';
import { route } from '../../i18n/routes';
import { t } from '../../i18n/messages';
export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (key: Parameters<typeof t>[1]) => t(locale, key);
// Add Classes here when its page is built; never link to an unbuilt page.
const paths = [
  { page: 'classes', title: 'classesTitle', text: 'classesIntro' },
  { page: 'retreats', title: 'retreatsTitle', text: 'retreatsIntro' },
  { page: 'library', title: 'libraryTitle', text: 'homeLibraryText' },
  { page: 'about', title: 'aboutTitle', text: 'homeAboutText' },
  { page: 'privacy', title: 'privacyTitle', text: 'homePrivacyText' },
] as const;
---

<Shell locale={locale} title={text('homeTitle')} page="home">
  <section class="hero">
    <div class="space-y-5">
      <h1 class="text-3xl font-bold sm:text-4xl">{text('homeTitle')}</h1>
      <p class="lead">{text('homeIntro')}</p>
      <p class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href={route(locale, 'library')}
          >{text('libraryTitle')}</a
        >
        <a class="btn btn-outline" href={route(locale, 'about')}
          >{text('aboutTitle')}</a
        >
      </p>
    </div>
    <img
      src="/logo-512.png"
      width="208"
      height="208"
      alt={text('logoAlt')}
      fetchpriority="high"
    />
  </section>
  <section class="space-y-4" aria-labelledby="start">
    <h2 id="start" class="text-2xl font-bold">{text('homeExplore')}</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        paths.map((item) => (
          <li class="card card-link space-y-2">
            <a class="link text-lg" href={route(locale, item.page)}>
              {text(item.title)}
            </a>
            <p class="muted">{text(item.text)}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Shell>
