---
import FeedbackDialog from '../components/FeedbackDialog.astro';
import FeedbackLink from '../components/FeedbackLink.astro';
import '../styles/global.css';
import { feedbackEnabled } from '../lib/feedback';
import { donateEnabled } from '../lib/donation';
import { miniAppsEnabled } from '../lib/mini-apps';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import NavIcon from '../components/NavIcon.astro';
import GearIcon from '../components/GearIcon.astro';
import Analytics from '../components/Analytics.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { channelLinks } from '../lib/classes';
import { locales, localeCodes, type Locale } from '../i18n/locales';
import { pagePaths, route, type PageId } from '../i18n/routes';
import { t } from '../i18n/messages';
import { allowIndexing, isBeta } from '../lib/site';
import {
  defaultPostLanguage,
  postLanguagesHeadScript,
} from '../lib/posts/languages';
interface Props {
  locale: Locale;
  title: string;
  page?: PageId;
  /** Path after the locale for pages that are not in pagePaths, e.g. dhamma-library/folders/f001/. */
  path?: string;
  /** Keep a page out of search results (it repeats another page), while following its links. */
  noindex?: boolean;
}
const { locale, title, page = 'home', path, noindex = false } = Astro.props;
const href = (code: Locale) => (path ? `/${code}/${path}` : route(code, page));
const canonical = new URL(href(locale), Astro.site);
// Only built pages are listed here; add Classes, Study groups, Retreats and Teachers as they land.
const navItems = [
  {
    page: 'classes',
    icon: 'classes',
    label: 'navClasses',
    children: [
      { page: 'teachers', icon: 'teachers', label: 'navTeachers' },
      { page: 'retreats', icon: 'retreats', label: 'navRetreats' },
    ],
  },
  { page: 'studyGroups', icon: 'studyGroups', label: 'navStudyGroups' },
  {
    page: 'library',
    icon: 'library',
    label: 'navLibrary',
    children: [
      { page: 'studyApps', icon: 'studyApps', label: 'navStudyApps' },
      { page: 'digitalTexts', icon: 'digitalTexts', label: 'navDigitalTexts' },
    ],
  },
  { page: 'posts', icon: 'posts', label: 'navPosts' },
  // The Dāna page is linked only once its wording is approved (docs/donations.md).
  ...(donateEnabled
    ? ([{ page: 'donate', icon: 'donate', label: 'navDonate' }] as const)
    : []),
  // The mini apps are linked only once they are approved (PUBLIC_MINI_APPS, meditation-bell.md §2).
  ...(miniAppsEnabled
    ? ([{ page: 'miniApps', icon: 'miniApps', label: 'navMiniApps' }] as const)
    : []),
] as const;
const inLibrary =
  page === 'library' ||
  page === 'studyApps' ||
  page === 'digitalTexts' ||
  Boolean(path?.startsWith('dhamma-library/'));
const inPosts = page === 'posts' || Boolean(path?.startsWith('dhamma-posts/'));
// Dhamma post languages ("Read in"): ?lang= first, then the saved choice, then the interface
// language; applied before paint (lib/posts/languages.ts).
const postLanguageScript = postLanguagesHeadScript(defaultPostLanguage(locale));
---

<!doctype html>
<html lang={locale} dir={locales[locale].direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!allowIndexing ? (
      <meta name="robots" content="noindex" />
    ) : (
      noindex && <meta name="robots" content="noindex, follow" />
    )}
    <title>{title} · {t(locale, 'brand')}</title>
    <link rel="canonical" href={canonical} />
    {localeCodes.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(href(code), Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline set:html={postLanguageScript} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">
      {t(locale, 'skip')}
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="brand-group">
          <a href={route(locale)} class="brand">
            <img src="/logo-96.png" width="44" height="44" alt="" />
            <span>{t(locale, 'brand')}</span>
          </a>
          {isBeta && (
            <a
              href={`${route(locale, 'about')}#beta`}
              class="beta-pill"
              aria-label={t(locale, 'betaLink')}
            >
              <span aria-hidden="true">{t(locale, 'betaLabel')}</span>
            </a>
          )}
        </div>
        <button
          type="button"
          class="menu-button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu
        >
          <svg
            class="menu-open"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            class="menu-close"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
          <span>{t(locale, 'menu')}</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label={t(locale, 'navMain')}>
          {navItems.map((item) => {
            const current = (target: string) =>
              page === target
                ? 'page'
                : (target === 'library' && inLibrary) ||
                    (target === 'posts' && inPosts)
                  ? 'true'
                  : (target === 'miniApps' && path?.startsWith('mini-apps/')) ||
                      (target === 'classes' && path?.startsWith('classes/'))
                    ? 'true'
                    : undefined;
            const link = (
              <a
                href={route(locale, item.page)}
                class="nav-link"
                aria-current={
                  current(item.page) ??
                  ('children' in item &&
                  item.children.some((child) => child.page === page)
                    ? 'true'
                    : undefined)
                }
              >
                <NavIcon name={item.icon} />
                {t(locale, item.label)}
              </a>
            );
            return 'children' in item ? (
              <div class="nav-group">
                {link}
                <ul class="nav-sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={route(locale, child.page)}
                        class="nav-sublink"
                        aria-current={
                          page === child.page ||
                          Boolean(path?.startsWith(pagePaths[child.page]))
                            ? 'page'
                            : undefined
                        }
                      >
                        <NavIcon name={child.icon} />
                        {t(locale, child.label)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              link
            );
          })}
          <a
            href={route(locale, 'settings')}
            class="nav-link nav-settings"
            aria-current={page === 'settings' ? 'page' : undefined}
          >
            <GearIcon class="nav-icon" />
            {t(locale, 'navSettings')}
          </a>
        </nav>
        <div class="header-tools">
          <LanguageSwitcher locale={locale} />
          <a
            href={route(locale, 'settings')}
            class="header-icon"
            aria-label={t(locale, 'navSettings')}
            title={t(locale, 'navSettings')}
            aria-current={page === 'settings' ? 'page' : undefined}
          >
            <GearIcon />
          </a>
        </div>
      </div>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav
          aria-label={t(locale, 'footerNav')}
          class="-ms-3 flex flex-wrap items-center gap-x-1"
        >
          <a
            href={route(locale, 'about')}
            class="footer-link"
            aria-current={page === 'about' ? 'page' : undefined}
          >
            {t(locale, 'navAbout')}
          </a>
          <a
            href={route(locale, 'privacy')}
            class="footer-link"
            aria-current={page === 'privacy' ? 'page' : undefined}
          >
            {t(locale, 'navPrivacy')}
          </a>
          <a
            href={route(locale, 'settings')}
            class="footer-link"
            aria-current={page === 'settings' ? 'page' : undefined}
          >
            {t(locale, 'navSettings')}
          </a>
          <a
            href={route(locale, 'zoomHelp')}
            class="footer-link"
            aria-current={page === 'zoomHelp' ? 'page' : undefined}
          >
            {t(locale, 'navZoomHelp')}
          </a>
          {donateEnabled && (
            <a
              href={route(locale, 'donate')}
              class="footer-link"
              aria-current={page === 'donate' ? 'page' : undefined}
            >
              {t(locale, 'navDonate')}
            </a>
          )}
          <FeedbackLink locale={locale} class="footer-link" />
          <a
            href={channelLinks.youtube}
            class="footer-link footer-link--brand"
            rel="noopener"
          >
            <BrandIcon name="youtube" />
            YouTube
          </a>
          <a
            href={channelLinks.facebook}
            class="footer-link footer-link--brand"
            rel="noopener"
          >
            <BrandIcon name="facebook" />
            Facebook
          </a>
          <a href="https://winmetta.org/" class="footer-link" rel="noopener">
            winmetta.org
          </a>
        </nav>
        <p class="muted">{t(locale, 'footerNote')}</p>
      </div>
    </footer>
    {feedbackEnabled && <FeedbackDialog locale={locale} />}
    <script>
      // Phones: the menu button shows and hides the navigation. Without JavaScript the links stay visible.
      const button = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.getElementById('site-nav');
      if (button && nav) {
        const set = (open: boolean) => {
          button.setAttribute('aria-expanded', String(open));
          nav.toggleAttribute('data-open', open);
        };
        button.addEventListener('click', () =>
          set(button.getAttribute('aria-expanded') !== 'true'),
        );
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
            set(false);
            button.focus();
          }
        });
      }
    </script>
  </body>
</html>
