{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "SITE_URL",
        "PUBLIC_ALLOW_INDEXING",
        "PUBLIC_LIBRARY_CDN_BASE",
        "PUBLIC_FEEDBACK",
        "PUBLIC_FEEDBACK_POSTS_REVIEWED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["FEEDBACK_STUB_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": []
    }
  },
  "globalDependencies": [".env.local"]
}
