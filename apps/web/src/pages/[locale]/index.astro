---
import Shell from '../../layouts/Shell.astro';
import MiniAppIcon from '../../components/MiniAppIcon.astro';
import { localeCodes, type Locale } from '../../i18n/locales';
import { miniAppRoute, postRoute, route } from '../../i18n/routes';
import { donateEnabled } from '../../lib/donation';
import { hasPage, miniApps, miniAppsEnabled } from '../../lib/mini-apps';
import { t } from '../../i18n/messages';
import { loadPosts } from '../../lib/posts/catalog';
import { defaultPostLanguage } from '../../lib/posts/languages';
import { recentPosts, sectionIn } from '../../lib/posts/posts';
export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = (key: Parameters<typeof t>[1]) => t(locale, key);
// Same order as the header menu. Never link to an unbuilt or unapproved page: Mini Apps and Donate
// appear only while they are on (PUBLIC_MINI_APPS, PUBLIC_DONATE).
const paths = [
  { page: 'library', title: 'libraryTitle', text: 'homeLibraryText' },
  { page: 'studyApps', title: 'studyAppsTitle', text: 'studyAppsIntro' },
  { page: 'posts', title: 'postsTitle', text: 'homePostsText' },
  ...(miniAppsEnabled
    ? ([
        { page: 'miniApps', title: 'miniAppsTitle', text: 'homeMiniAppsText' },
      ] as const)
    : []),
  { page: 'classes', title: 'classesTitle', text: 'classesIntro' },
  { page: 'retreats', title: 'retreatsTitle', text: 'retreatsIntro' },
  { page: 'studyGroups', title: 'navStudyGroups', text: 'studyGroupsIntro' },
  ...(donateEnabled
    ? ([
        { page: 'donate', title: 'navDonate', text: 'homeDonateText' },
      ] as const)
    : []),
  { page: 'about', title: 'aboutTitle', text: 'homeAboutText' },
] as const;
// The home page names recent posts in the interface language only.
const latest = recentPosts(await loadPosts(), 3).flatMap((post) => {
  const section = sectionIn(post, defaultPostLanguage(locale));
  return section
    ? [{ id: post.id, title: section.title, lang: section.lang }]
    : [];
});
---

<Shell locale={locale} title={text('homeTitle')} page="home">
  <section class="hero">
    <div class="space-y-5">
      <h1 class="text-3xl font-bold sm:text-4xl">{text('homeTitle')}</h1>
      <p class="lead">{text('homeIntro')}</p>
      <p class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href={route(locale, 'library')}>
          {text('libraryTitle')}
        </a>
        <a class="btn btn-outline" href={route(locale, 'about')}>
          {text('aboutTitle')}
        </a>
      </p>
    </div>
    <img
      src="/logo-512.png"
      width="208"
      height="208"
      alt={text('logoAlt')}
      fetchpriority="high"
    />
  </section>
  <section class="space-y-4" aria-labelledby="start">
    <h2 id="start" class="text-2xl font-bold">
      {text('homeExplore')}
    </h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {paths.map((item) => (
        <li class="card card-link space-y-2">
          <a class="link text-lg" href={route(locale, item.page)}>
            {text(item.title)}
          </a>
          <p class="muted">{text(item.text)}</p>
        </li>
      ))}
    </ul>
  </section>
  {miniAppsEnabled && (
    <section class="space-y-4" aria-labelledby="home-mini-apps">
      <h2 id="home-mini-apps" class="text-2xl font-bold">
        {text('miniAppsTitle')}
      </h2>
      <p class="muted">{text('homeMiniAppsIntro')}</p>
      <ul class="mini-grid" aria-label={text('miniAppsList')}>
        {miniApps.map((app) => {
          const inner = (
            <>
              <MiniAppIcon icon={app.icon} size={64} />
              <span class="font-semibold">{text(app.name)}</span>
              <span class="badge">
                {app.status === 'coming'
                  ? text('miniAppComing')
                  : app.status === 'beta'
                    ? text('betaLabel')
                    : ''}
              </span>
            </>
          );
          return (
            <li>
              {hasPage(app) ? (
                <a
                  href={miniAppRoute(locale, app.slug)}
                  class="mini-tile"
                  aria-describedby={`home-desc-${app.id}`}
                >
                  {inner}
                </a>
              ) : (
                <div class="mini-tile mini-tile--coming">{inner}</div>
              )}
              <p id={`home-desc-${app.id}`} class="sr-only">
                {text(app.description)}
              </p>
            </li>
          );
        })}
      </ul>
      <p>
        <a class="link" href={route(locale, 'miniApps')}>
          {text('miniAppsTitle')}
        </a>
      </p>
    </section>
  )}
  <section class="space-y-4" aria-labelledby="recent-posts">
    <h2 id="recent-posts" class="text-2xl font-bold">
      {text('postsRecent')}
    </h2>
    <ul class="grid gap-3">
      {latest.map((post) => (
        <li class="card card-link">
          <a
            class="link text-lg"
            href={postRoute(locale, post.id)}
            lang={post.lang}
          >
            {post.title}
          </a>
        </li>
      ))}
    </ul>
    <p>
      <a class="link" href={route(locale, 'posts')}>
        {text('postsAllLink')}
      </a>
    </p>
  </section>
</Shell>
