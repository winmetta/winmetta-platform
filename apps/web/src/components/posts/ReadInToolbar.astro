---
// The "Read in" box on post and tag pages: the post language picker, Share and (posts) Print.
import PostLanguagePicker from './PostLanguagePicker.astro';
import PostTools from './PostTools.astro';
import type { Locale } from '../../i18n/locales';
interface Props {
  locale: Locale;
  /** Canonical address of the page, shared with the current ?lang=. */
  url: string;
  title: string;
  print?: boolean;
}
const { locale, url, title, print = false } = Astro.props;
---

<div class="post-toolbar no-print">
  <PostLanguagePicker locale={locale} />
  <PostTools locale={locale} url={url} title={title} print={print} />
</div>
