---
// Small line icons for plain links (recordings, course details, book). Decorative: the link
// text beside the icon names the destination.
interface Props {
  name:
    | 'recordings'
    | 'course'
    | 'book'
    | 'live'
    | 'language'
    | 'teacher'
    | 'folder'
    | 'file'
    | 'computer'
    | 'transfer'
    | 'mail';
  /** Extra classes, e.g. a larger size beside a heading. */
  class?: string;
}
const { name, class: extra } = Astro.props;
---

<svg
  class:list={['link-icon', extra]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'transfer' && (
    <>
      <rect x="3" y="2" width="10" height="20" rx="2" />
      <path d="M7 18h2" />
      <path d="M13 9h8m-3-3 3 3-3 3" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
  {name === 'computer' && (
    <>
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </>
  )}
  {name === 'file' && (
    <>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5" />
    </>
  )}
  {name === 'folder' && (
    <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
  )}
  {name === 'teacher' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </>
  )}
  {name === 'language' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
    </>
  )}
  {name === 'live' && (
    <>
      <circle cx="12" cy="12" r="2" />
      <path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4" />
      <path d="M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5" />
    </>
  )}
  {name === 'recordings' && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="3" />
      <path d="m10 9 5 3-5 3z" />
    </>
  )}
  {(name === 'course' || name === 'book') && (
    <>
      <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z" />
      <path d="M4 21a2 2 0 0 0 2 2h13v-4" />
      <path d="M9 7h6" />
    </>
  )}
</svg>
