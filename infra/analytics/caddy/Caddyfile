{
	# Needed so the rate_limit handler runs before the proxy.
	order rate_limit before reverse_proxy
	admin off
}

{$STATS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	rate_limit {
		# Dashboard sign-in: slow down password guessing. Umami also locks 2FA attempts itself.
		zone login {
			match {
				path /api/auth/login
			}
			key {remote_host}
			events 10
			window 10m
		}
		# Collection endpoint: generous (shared networks), but stops floods of fake events.
		zone collect {
			match {
				path /api/send
			}
			key {remote_host}
			events 600
			window 1m
		}
	}

	reverse_proxy analytics-umami:3000
}
