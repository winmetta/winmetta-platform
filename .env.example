# Committed documentation. Copy to root .env.local for developer-machine overrides.
# CI uses GitHub staging/production environment variables; do not create env files for them.
# Never put secrets in PUBLIC_* variables: they can appear in the generated site.
# Origin used for canonical and alternate-language URLs. Defaults to http://localhost:4321.
SITE_URL=http://localhost:4321
# Only the public production site sets this to "true". Anything else sends noindex.
PUBLIC_ALLOW_INDEXING=false
